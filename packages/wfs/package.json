{
  "name": "@spatial-api/wfs",
  "version": "1.0.0",
  "description": "Express middleware and protocol handlers for WFS (Web Feature Service)",
  "keywords": [
    "wfs",
    "web-feature-service",
    "ogc",
    "gis",
    "spatial",
    "express",
    "middleware",
    "typescript",
    "geojson"
  ],
  "author": "Spatial API Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exsilium122/spatial-libs.git"
  },
  "bugs": {
    "url": "https://github.com/Exsilium122/spatial-libs/issues"
  },
  "homepage": "https://github.com/Exsilium122/spatial-libs/tree/main/packages/wfs#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
