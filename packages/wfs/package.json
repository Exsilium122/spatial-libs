{
  "name": "@spatial-api/wfs",
  "version": "1.1.1",
  "description": "Express middleware and protocol handlers for WFS (Web Feature Service)",
  "keywords": [
    "wfs",
    "web-feature-service",
    "ogc",
    "gis",
    "spatial",
    "express",
    "middleware",
    "typescript",
    "geojson"
  ],
  "author": "Spatial API Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exsilium122/spatial-libs.git",
    "directory": "packages/wfs"
  },
  "bugs": {
    "url": "https://github.com/Exsilium122/spatial-libs/issues"
  },
  "homepage": "https://github.com/Exsilium122/spatial-libs/tree/main/packages/wfs#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --minify --platform=node --format=esm --packages=external --outfile=dist/index.js && esbuild src/index.ts --bundle --minify --platform=node --format=cjs --packages=external --outfile=dist/index.cjs && node -e \"fs.copyFileSync('dist/index.d.ts', 'dist/index.d.cts')\"",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0"
  },
  "peerDependencies": {
    "express": "^4.0.0",
    "express-xml-bodyparser": "^0.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
