{
  "name": "@spatial-api/tester",
  "version": "1.1.3",
  "description": "Interactive and automated smoke and concurrent stress testing CLI for WFS and OGC API Features",
  "keywords": [
    "wfs",
    "ogc",
    "ogc-api-features",
    "gis",
    "spatial",
    "tester",
    "cli",
    "smoke-test",
    "stress-test"
  ],
  "author": "Spatial API Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exsilium122/spatial-libs.git",
    "directory": "packages/tester"
  },
  "bugs": {
    "url": "https://github.com/Exsilium122/spatial-libs/issues"
  },
  "homepage": "https://github.com/Exsilium122/spatial-libs/tree/main/packages/tester#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "bin": {
    "tester": "dist/index.js",
    "spatial-tester": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --minify --platform=node --format=esm --packages=external --outfile=dist/index.js",
